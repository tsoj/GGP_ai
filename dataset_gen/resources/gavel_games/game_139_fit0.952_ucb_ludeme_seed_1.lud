(game
  "GAME_NAME"
  (players 2)
  (equipment {(board (square 19)) (piece "PIECE_ALPHA" Each)})
  (rules
    (play
      (move
        Add
        (to (sites Empty))
        (then
          (if
            (not (is Prev Mover))
            (enclose
              (from (last To))
              Orthogonal
              (between if: (is Enemy (who at: (between))) (apply (remove (between))))
            )
          )
        )
      )
    )
    (end
      (if
        (or
          {
            (is Loop)
            (is Connected 3 SidesNoCorners)
            (is Connected 2 Corners)
          }
        )
        (result Mover Win)
      )
    )
  )
)
