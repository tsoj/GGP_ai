(game
  "GAME_NAME"
  (players 2)
  (equipment
    {(board (rotate 90 (hex 5))) (piece "PIECE_ALPHA" Each)}
  )
  (rules
    (meta (swap))
    (play
      (move
        Add
        (to (sites Empty))
        (then
          (and
            (set Score Mover 0)
            (forEach
              Group
              Orthogonal
              if:
              (is Mover (who at: (to)))
              (if
                (is Full)
                (and
                  (addScore Mover -1)
                  (forEach Site (sites) (set State at: (site) 1))
                )
                (forEach Site (sites) (set State at: (site) 0))
              )
            )
          )
        )
      )
    )
    (end
      {
        (if (is Line 4) (result Mover Win))
        (if (is Line 3) (result Mover Loss))
      }
    )
  )
)
