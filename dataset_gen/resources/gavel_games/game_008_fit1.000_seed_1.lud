(game
  "GAME_NAME"
  (players {(player N) (player S)})
  (equipment
    {
      (board (square 8))
      (piece
        "PIECE_ALPHA"
        Each
        (move
          Step
          (directions {FR FL})
          (to
            if:
            (not (is Friend (who at: (to))))
            (apply
              (if
                (is Enemy (who at: (to)))
                (forEach Level (to) (remove (to) level: (level)))
              )
            )
          )
        )
      )
      (regions P1 (sites Top))
      (regions P2 (sites Bottom))
    }
  )
  (rules
    (start
      {
        (place "PIECE_ALPHA1" (expand (sites Bottom)))
        (place "PIECE_ALPHA2" (expand (sites Top)))
      }
    )
    (play (forEach Piece))
    (end
      (if (is In (last To) (sites Mover)) (result Mover Win))
    )
  )
)
