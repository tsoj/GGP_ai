(game
  "GAME_NAME"
  (players 2)
  (equipment
    {(board (square 9) use:Vertex) (piece "PIECE_ALPHA" Each)}
  )
  (rules
    (play
      (move
        Add
        (to (sites Empty))
        (then
          (and
            (set Score Mover 0)
            (forEach
              Group
              Orthogonal
              if:
              (is Mover (who at: (to)))
              (if
                (is Odd (count Sites in: (sites)))
                (and
                  (addScore Mover -1)
                  (forEach Site (sites) (set State at: (site) 1))
                )
                (forEach Site (sites) (set State at: (site) 0))
              )
            )
          )
        )
      )
    )
    (end (if (is Line 4) (result Mover Win)))
  )
)
