(game
  "GAME_NAME"
  (players {(player N) (player S)})
  (equipment
    {
      (board (square 8))
      (piece
        "PIECE_ALPHA"
        Each
        (move
          Step
          (to
            if:
            (not (is Friend (who at: (to))))
            (apply (remove (what at: (to))))
          )
        )
      )
      (piece "PIECE_BETA" Each)
    }
  )
  (rules
    (play (move Add (to (sites Empty))))
    (end
      (if
        (or
          {
            (is Loop)
            (is Connected 3 SidesNoCorners)
            (is Connected 2 Corners)
          }
        )
        (result Mover Win)
      )
    )
  )
)
