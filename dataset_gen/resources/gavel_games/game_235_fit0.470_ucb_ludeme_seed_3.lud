(game
  "GAME_NAME"
  (players 2)
  (equipment
    {
      (board (rectangle 7 11))
      (piece
        "PIECE_ALPHA"
        Each
        (or
          (move
            (from)
            (to (sites Around (from)) if: (is Empty (to)))
            copy:True
          )
          (move
            (from)
            (to
              (difference (sites Outer) (expand origin: (from)))
              if:
              (is Empty (to))
            )
          )
          (then
            (forEach
              Site
              (intersection (sites Around (last To)) (sites Occupied by:Next))
              (and
                (remove (site))
                (add (piece (id "PIECE_ALPHA" Mover)) (to (site)))
              )
            )
          )
        )
      )
    }
  )
  (rules
    (start
      {
        (set Score Each 2)
        (place "PIECE_ALPHA1" {"A1" "G7"})
        (place "PIECE_ALPHA2" {"A7" "G1"})
      }
    )
    (play
      (forEach
        Piece
        (then
          (and
            (set
              Score
              Mover
              (count Sites in: (sites Occupied by:Mover))
            )
            (set Score P2 (count Sites in: (sites Occupied by:P2)))
          )
        )
      )
    )
    (end
      (if
        (or
          (and (is Pending) (no Pieces Next))
          (< (count Pieces Mover) (score Mover))
        )
        (byScore)
      )
    )
  )
)
