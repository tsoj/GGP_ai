(game
  "GAME_NAME"
  (players 2)
  (equipment
    {
      (board (rotate 90 (tiling T3464 2)))
      (piece "PIECE_ALPHA" Each)
    }
  )
  (rules
    (play (move Add (to (sites Empty))))
    (end
      (if
        (is Full)
        (byScore
          {
            (score
              P1
              (+
                (results
                  from:
                  (sites Occupied by:P1)
                  to:0
                  (if (= (id P1) (who at: (to))) 1 0)
                )
              )
            )
            (score
              P2
              (+
                (results
                  from:
                  (sites Occupied by:P2)
                  to:0
                  (if (= (id P2) (who at: (to))) 1 0)
                )
              )
            )
          }
        )
      )
    )
  )
)
