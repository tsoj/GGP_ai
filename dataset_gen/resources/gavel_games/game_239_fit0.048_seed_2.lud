(game
  "GAME_NAME"
  (players 2)
  (equipment
    {
      (board (rectangle 5 5 diagonals:Alternating) use:Vertex)
      (piece
        "PIECE_ALPHA"
        P1
        (move Step (to if: (is Empty (to))))
      )
      (piece
        "PIECE_BETA"
        P2
        (or
          (move Step (to if: (is Empty (to))))
          (move
            Hop
            (between if: (is Enemy (who at: (between))) (apply (remove (between))))
            (to if: (is Empty (to)))
          )
        )
      )
      (hand P1)
    }
  )
  (rules
    (play
      (or
        (move
          Add
          (to (sites Empty))
          (then (if (= 1 (count MovesThisTurn)) (moveAgain)))
        )
        (if (= 1 (var)) (move Pass))
      )
    )
    (end
      (if
        (or
          {
            (is Loop)
            (is Connected 3 SidesNoCorners)
            (is Connected 2 Corners)
          }
        )
        (result Mover Win)
      )
    )
  )
)
