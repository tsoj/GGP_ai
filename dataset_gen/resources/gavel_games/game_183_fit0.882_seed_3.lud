(game
  "GAME_NAME"
  (players 2)
  (equipment
    {
      (board (square 7))
      (piece "PIECE_ALPHA" P1 (move Slide Orthogonal))
      (piece "PIECE_BETA" P2 (move Step (to if: (is Empty (to)))))
    }
  )
  (rules
    (meta (swap))
    (play (move Add (to (sites Empty))))
    (end
      {
        (if (is Line 4) (result Mover Win))
        (if (is Line 3) (result Mover Loss))
      }
    )
  )
)
