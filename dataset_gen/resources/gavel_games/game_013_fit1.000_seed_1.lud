(game
  "GAME_NAME"
  (players 2)
  (equipment
    {(board (square 9) use:Vertex) (piece "PIECE_ALPHA" Each)}
  )
  (rules
    (play
      (move
        Add
        (to
          (sites Empty)
          if:
          (<=
            (count Steps All (to) (sites Perimeter))
            (count
              Sites
              in:
              (intersection
                (sites LineOfSight at: (to) All)
                (sites Occupied by:Mover)
              )
            )
          )
        )
      )
    )
    (end (if (is Line 5 All exact:True) (result Mover Win)))
  )
)
