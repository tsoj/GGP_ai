(game
  "GAME_NAME"
  (players 2)
  (equipment
    {
      (board
        (merge
          {
            (rectangle 1 10)
            (shift 0 9 (rectangle 1 10))
            (shift -1 -1 (square 2))
            (shift 9 -1 (square 2))
            (rectangle 10 1)
            (shift 9 0 (rectangle 10 1))
            (shift -1 9 (square 2))
            (shift 9 9 (square 2))
            (shift 5 0 (rectangle 6 1))
            (shift 0 5 (rectangle 1 6))
            (shift 4 4 (rectangle 1 6))
            (shift 4 4 (rectangle 6 1))
          }
        )
        {
          (track "Track1" "62,W,N1,E,N1,W,N1,E,S1,W,S1,E" loop:True P1)
          (track "Track2" "51,E,S1,W,S1,E,S1,W,N1,E,N1,W" loop:True P2)
        }
      )
      (piece "PIECE_ALPHA" Each)
    }
  )
  (rules
    (play
      (move
        Add
        (to
          (sites Empty)
          if:
          (<=
            (count Steps All (to) (sites Perimeter))
            (count
              Sites
              in:
              (intersection
                (sites LineOfSight at: (to) All)
                (sites Occupied by:Mover)
              )
            )
          )
        )
      )
    )
    (end (if (is Occupied (centrePoint)) (result Next Loss)))
  )
)
