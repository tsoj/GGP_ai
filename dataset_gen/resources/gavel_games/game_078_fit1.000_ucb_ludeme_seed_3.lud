(game
  "GAME_NAME"
  (players 2)
  (equipment
    {(board (square 15) use:Vertex) (piece "PIECE_ALPHA" Each)}
  )
  (rules
    (play
      (move
        Add
        (to (sites Empty))
        (then
          (if
            (is In (last To) (sites Centre))
            (do
              (moveAgain)
              next:
              (enclose
                (from (last To))
                Orthogonal
                (between
                  if:
                  (is Enemy (who at: (between)))
                  (apply (and (trigger "Placed" Next) (remove (between))))
                )
              )
            )
          )
        )
      )
    )
    (end (if (is Line 5 All exact:True) (result Mover Win)))
  )
)
