(game
  "GAME_NAME"
  (players 2)
  (equipment
    {
      (board
        (merge
          {
            (shift 2 2 (square 5 diagonals:Alternating))
            (shift 2 0 (wedge 3))
            (shift 5 3 (rotate 90 (wedge 3)))
            (shift 2 6 (rotate 180 (wedge 3)))
            (shift -1 3 (rotate 270 (wedge 3)))
          }
        )
        use:Vertex
      )
      (piece "PIECE_ALPHA" Each)
    }
  )
  (rules
    (play
      (move
        Add
        (to
          (sites Empty)
          if:
          (<=
            (count Steps All (to) (sites Perimeter))
            (count
              Sites
              in:
              (intersection
                (sites LineOfSight at: (to) All)
                (sites Occupied by:Mover)
              )
            )
          )
        )
      )
    )
    (end (if (is Occupied (centrePoint)) (result Next Loss)))
  )
)
