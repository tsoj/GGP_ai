(game
  "GAME_NAME"
  (players 2)
  (equipment
    {(board (square 13) use:Vertex) (piece "PIECE_ALPHA" Each)}
  )
  (rules
    (play
      (do
        (move
          Add
          (to (sites Empty))
          (then
            (enclose
              (from (last To))
              Orthogonal
              (between
                if:
                (is Enemy (who at: (between)))
                (apply
                  (and
                    (remove (between))
                    (add (piece (id "PIECE_ALPHA" Mover)) (to (between)))
                  )
                )
              )
            )
          )
        )
        ifAfterwards:
        (> (count Liberties Orthogonal) 0)
      )
    )
    (end
      {
        (if (is Line 5) (result Mover Win))
        (if (no Moves Next) (result Mover Win))
      }
    )
  )
)
