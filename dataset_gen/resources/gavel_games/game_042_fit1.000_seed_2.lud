(game
  "GAME_NAME"
  (players 2)
  (equipment
    {(board (square 15) use:Vertex) (piece "PIECE_ALPHA" Each)}
  )
  (rules
    (play
      (move
        Add
        (to (sites Empty))
        (then
          (if
            (=
              (count
                Sites
                in:
                (sites Around (last To) NotEmpty Orthogonal)
              )
              1
            )
            (moveAgain)
          )
        )
      )
    )
    (end (if (is Line 6 Orthogonal) (result Mover Win)))
  )
)
