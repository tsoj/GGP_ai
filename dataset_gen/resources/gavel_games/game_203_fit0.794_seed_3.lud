(game
  "GAME_NAME"
  (players 2)
  (equipment
    {
      (board
        (intersect {(hex 7) (shift -5.2 0 (hex Rectangle 7 14))})
      )
      (piece "PIECE_ALPHA" Each)
    }
  )
  (rules
    (start
      {
        (set Score Each 2)
        (place "PIECE_ALPHA1" {"A1" "G7"})
        (place "PIECE_ALPHA2" {"A7" "G1"})
      }
    )
    (play
      (move
        Add
        (to (sites Empty))
        (then
          (and
            (set Score Mover 0)
            (forEach
              Group
              Orthogonal
              if:
              (is Mover (who at: (to)))
              (if
                (is Odd (count Sites in: (sites)))
                (and
                  (addScore Mover -1)
                  (forEach Site (sites) (set State at: (site) 0))
                )
                (and
                  (addScore Mover -2)
                  (forEach Site (sites) (set State at: (site) 1))
                )
              )
            )
          )
        )
      )
    )
    (end
      (if
        (or
          (= (count Sites in: (sites Occupied by:Mover)) 0)
          (is Full)
        )
        (byScore)
      )
    )
  )
)
