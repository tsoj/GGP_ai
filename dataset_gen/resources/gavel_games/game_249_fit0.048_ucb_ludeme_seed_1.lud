(game
  "GAME_NAME"
  (players 2)
  (equipment
    {
      (board (square 5 diagonals:Solid) use:Vertex)
      (piece "PIECE_ALPHA" Each)
    }
  )
  (rules
    (play (move Add (to (sites Empty))))
    (end
      (if
        (is Full)
        (byScore
          {
            (score
              P1
              (*
                10
                (count
                  Sites
                  in:
                  (difference (sites Top) (sites Group at: (last To)))
                )
              )
            )
            (score
              P2
              (*
                10
                (count
                  Sites
                  in:
                  (difference (sites Bottom) (sites Group at: (last To)))
                )
              )
            )
          }
        )
      )
    )
  )
)
