(game
  "GAME_NAME"
  (players 2)
  (equipment
    {
      (board (square 10))
      (piece
        "PIECE_ALPHA"
        Each
        (move
          Step
          Orthogonal
          (to (apply (if (is Occupied (to)) (remove (to)))))
          (then
            (if
              (>
                (*
                  (count
                    Sites
                    in:
                    (forEach (sites Around (last To)) if: (is Friend (who at: (site))))
                  )
                  2
                )
                (count
                  Sites
                  in:
                  (forEach (sites Around (last To)) if: (is Enemy (who at: (site))))
                )
              )
              (forEach
                Site
                (sites Around (last To))
                (if (is Enemy (who at: (site))) (remove (site)))
              )
            )
          )
        )
      )
      (piece "PIECE_BETA" Each)
    }
  )
  (rules
    (start
      {
        (place "PIECE_ALPHA1" (sites Phase 1))
        (place "PIECE_ALPHA2" (sites Phase 0))
      }
    )
    (play (forEach Piece))
    (end (if (is Line 4 Orthogonal) (result Mover Win)))
  )
)
