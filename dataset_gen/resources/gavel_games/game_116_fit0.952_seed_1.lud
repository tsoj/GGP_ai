(game
  "GAME_NAME"
  (players 2)
  (equipment
    {
      (board (tri {3 5 3 5 3}) use:Vertex)
      (piece "PIECE_ALPHA" Each)
    }
  )
  (rules
    (play
      (if
        (is Prev Mover)
        (move
          Remove
          (sites Occupied by:Enemy container: (var "Board"))
        )
        (move
          Add
          (to (sites Empty))
          (then (if (is Line 3) (moveAgain)))
        )
      )
    )
    (end (if (is Line 5 All exact:True) (result Mover Win)))
  )
)
