(game
  "GAME_NAME"
  (players 2)
  (equipment {(board (hex 6)) (piece "PIECE_ALPHA" Each)})
  (rules
    (play
      (move
        Add
        (to (sites Empty))
        (then (if (not (is Prev Mover)) (moveAgain)))
      )
    )
    (end
      (if
        (is Connected {(sites Side N) (sites Side S)})
        (result Mover Win)
      )
    )
  )
)
