(game
  "GAME_NAME"
  (players 2)
  (equipment
    {
      (board (hex Limping (- 5 1)) use:Vertex)
      (piece "PIECE_ALPHA" Each)
    }
  )
  (rules
    (play (move Add (to (sites Empty))))
    (end
      (if
        (or
          {
            (is Loop)
            (is Connected 3 SidesNoCorners)
            (is Connected 4 SidesNoCorners)
          }
        )
        (result Mover Win)
      )
    )
  )
)
