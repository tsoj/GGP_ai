(game
  "GAME_NAME"
  (players 2)
  (equipment
    {
      (board (scale 1 2 (wedge 4)) use:Vertex)
      (piece "PIECE_ALPHA" Each)
    }
  )
  (rules
    (play
      (move
        Add
        (to (sites Empty))
        (then
          (if (and (not (is Prev Mover)) (is Line 3)) (moveAgain))
        )
      )
    )
    (end (if (is Full) (result Mover Win)))
  )
)
