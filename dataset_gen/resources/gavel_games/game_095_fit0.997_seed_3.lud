(game
  "GAME_NAME"
  (players 2)
  (equipment {(board (square 8)) (piece "PIECE_ALPHA" Each)})
  (rules
    (meta (swap))
    (play
      (move
        Add
        (to (sites Empty))
        (then
          (and
            (surround
              (from (last To))
              Orthogonal
              (between if: (is Occupied (between)) (apply (remove (between))))
            )
            (forEach
              Group
              Orthogonal
              if:
              (is Mover (who at: (to)))
              (if
                (is Odd (count Sites in: (sites)))
                (and
                  (addScore Mover -1)
                  (forEach Site (sites) (set State at: (site) 0))
                )
                (and
                  (addScore Mover -2)
                  (forEach Site (sites) (set State at: (site) 1))
                )
              )
            )
          )
        )
      )
    )
    (end (if (is Full) (byScore)))
  )
)
