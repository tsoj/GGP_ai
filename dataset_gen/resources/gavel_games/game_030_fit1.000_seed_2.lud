(game
  "GAME_NAME"
  (players 2)
  (equipment {(board (hex 8)) (piece "PIECE_ALPHA" Each)})
  (rules
    (play
      (if
        (= 1 (var))
        (or
          (move Swap Players P1 P2)
          (move Add (to (sites Empty)) (then (set Var 0)))
        )
        (move
          Add
          (to (sites Empty))
          (then (if (= 1 (count Moves)) (set Var 1)))
        )
      )
    )
    (end
      (if
        (or
          {
            (is Loop)
            (is Connected 3 SidesNoCorners)
            (is Connected 2 Corners)
          }
        )
        (result Mover Win)
      )
    )
  )
)
