(game
  "GAME_NAME"
  (players 2)
  (equipment {(board (square 6)) (piece "PIECE_ALPHA" Each)})
  (rules
    (play
      (move
        Add
        (to
          (sites Empty)
          if:
          (or (is Flat) (is Pattern {F R F F L F R F}))
        )
      )
    )
    (end (if (is Line 4) (result Mover Win)))
  )
)
