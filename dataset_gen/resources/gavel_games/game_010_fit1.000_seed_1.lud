(game
  "GAME_NAME"
  (players {(player N) (player S)})
  (equipment
    {(board (square 15) use:Vertex) (piece "PIECE_ALPHA" Each)}
  )
  (rules
    (play
      (or
        (move
          Add
          (to (sites Empty) if: (= (id P1) (mover)))
          (then
            (and
              (if (= (count MovesThisTurn) 1) (moveAgain))
              (if (!= (count MovesThisTurn) 1) (set Counter))
            )
          )
        )
        (move
          Add
          (to (sites Empty) if: (= (id P2) (mover)))
          (then
            (and
              (if (= (count MovesThisTurn) 1) (moveAgain))
              (if (!= (count MovesThisTurn) 1) (set Counter))
            )
          )
        )
      )
    )
    (end
      {
        (if (is Line 5 All) (result Mover Win))
        (if (is Line 3 All) (result Mover Loss))
      }
    )
  )
)
