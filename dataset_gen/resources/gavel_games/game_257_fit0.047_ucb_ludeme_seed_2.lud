(game
  "GAME_NAME"
  (players 2)
  (equipment
    {
      (board (square 7))
      (piece
        "PIECE_ALPHA"
        Each
        (or
          (move
            (from)
            (to (sites Around (from)) if: (is Empty (to)))
            copy:True
          )
          (move
            (from (from) level: (level))
            (to
              (sites
                Around
                (last To)
                if:
                (and
                  (is Empty (to))
                  (<
                    (count
                      Sites
                      in:
                      (intersection (sites Around (to)) (sites Occupied by:Next))
                    )
                    (count
                      Sites
                      in:
                      (intersection
                        (sites Around (from) includeSelf:True)
                        (sites Occupied by:Next)
                      )
                    )
                  )
                )
              )
              if:
              (is Empty (to))
            )
          )
          (then
            (forEach
              Site
              (intersection (sites Around (last To)) (sites Occupied by:Next))
              (and (remove (site)) (moveAgain))
            )
          )
        )
      )
    }
  )
  (rules
    (start
      {
        (place "PIECE_ALPHA1" (sites Bottom))
        (place "PIECE_ALPHA1" {"A1" "G7"})
        (place "PIECE_ALPHA2" {"A7" "G1"})
      }
    )
    (play
      (forEach
        Piece
        (then
          (and
            (set
              Score
              Mover
              (count Sites in: (sites Occupied by:Mover))
            )
            (set Score Next (count Sites in: (sites Occupied by:Next)))
          )
        )
      )
    )
    (end
      (if
        (or
          (= (count Sites in: (sites Occupied by:Next)) 0)
          (is Full)
        )
        (byScore)
      )
    )
  )
)
