(game
  "GAME_NAME"
  (players 2)
  (equipment
    {(board (square 15) use:Vertex) (piece "PIECE_ALPHA" Each)}
  )
  (rules
    (play
      (do
        (move Add (to (sites Empty)))
        ifAfterwards:
        (not
          (can
            Move
            (move
              Hop
              (between if: (is Enemy (who at: (between))) (apply (remove (between))))
              (to if: (is Empty (to)))
            )
          )
        )
      )
    )
    (end (if (is Line 5 All exact:True) (result Mover Win)))
  )
)
