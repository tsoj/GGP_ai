(game
  "GAME_NAME"
  (players 2)
  (equipment {(board (square 8)) (piece "PIECE_ALPHA" Each)})
  (rules
    (play
      (do
        (move Add (to (sites Empty)))
        ifAfterwards:
        (not (can Move (do (move Add (to (sites Empty))))))
      )
    )
    (end (if (is Line 5) (result Mover Win)))
  )
)
