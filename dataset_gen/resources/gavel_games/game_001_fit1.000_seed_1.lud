(game
  "GAME_NAME"
  (players 2)
  (equipment
    {(board (square 9) use:Vertex) (piece "PIECE_ALPHA" Each)}
  )
  (rules
    (play
      (if
        (= 1 (var))
        (or
          (move Pass)
          (move
            Hop
            (between if: (is Enemy (who at: (between))) (apply (remove (between))))
            (to if: (is Empty (to)))
            (then
              (if
                (can
                  Move
                  (hop
                    (from (last To))
                    (between
                      if:
                      (and
                        (not (is In (between) (sites ToClear)))
                        (is Enemy (who at: (between)))
                      )
                    )
                    (to if: (is Empty (to)))
                  )
                )
                (moveAgain)
              )
            )
          )
        )
        (move
          Add
          (to (sites Empty))
          (then
            (if
              (not (can Move (move Add (to (sites Empty)))))
              (moveAgain)
            )
          )
        )
      )
    )
    (end (if (is Line 5 All exact:True) (result Mover Win)))
  )
)
