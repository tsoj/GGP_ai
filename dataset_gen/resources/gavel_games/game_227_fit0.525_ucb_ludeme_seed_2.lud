(game
  "GAME_NAME"
  (players {(player N) (player S)})
  (equipment
    {
      (board
        (merge
          (shift
            0
            (/ (- 7 3) 2)
            (rectangle 3 7 diagonals:Alternating)
          )
          (shift
            (/ (- 7 3) 2)
            0
            (rectangle 7 3 diagonals:Alternating)
          )
        )
        use:Vertex
      )
      (piece "PIECE_ALPHA" P1 N)
      (piece "PIECE_ALPHA" P2 S)
      (piece "PIECE_BETA" Each)
      (regions P1 (sites Bottom))
      (regions P2 (sites Top))
    }
  )
  (rules
    (play (move Add (to (sites Empty))))
    (end (if (is Line 4 byLevel:True) (result Mover Win)))
  )
)
