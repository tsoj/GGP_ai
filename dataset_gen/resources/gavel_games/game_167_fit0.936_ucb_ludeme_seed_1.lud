(game
  "GAME_NAME"
  (players 2)
  (equipment
    {
      (board (square 8))
      (piece
        "PIECE_ALPHA"
        P2
        N
        (move Step (directions {FR FL}) (to if: (is Empty (to))))
      )
      (piece
        "PIECE_BETA"
        P1
        (move Step Diagonal (to if: (is Empty (to))))
      )
      (hand P1)
    }
  )
  (rules
    (play (move Add (to (sites Empty))))
    (end
      {
        (if (is Line 5) (result Mover Win))
        (if (is Line 4) (result Mover Loss))
      }
    )
  )
)
