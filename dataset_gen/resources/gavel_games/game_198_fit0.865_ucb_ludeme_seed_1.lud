(game
  "GAME_NAME"
  (players 2)
  (equipment
    {(board (square 13) use:Vertex) (piece "PIECE_ALPHA" Each)}
  )
  (rules
    (play
      (or
        (do
          (move Add (to (sites Empty)))
          ifAfterwards:
          (> (count Liberties Orthogonal) 0)
          (then
            (enclose
              (from (last To))
              Orthogonal
              (between
                if:
                (is Enemy (who at: (between)))
                (apply (and (addScore Mover 1) (remove (between))))
              )
            )
          )
        )
        (move
          Add
          (to (sites Empty))
          (then (if (is Line 4) (moveAgain)))
        )
      )
    )
    (end
      {
        (if (is Line 5) (result Mover Win))
        (if (is Line 4) (result Mover Loss))
      }
    )
  )
)
