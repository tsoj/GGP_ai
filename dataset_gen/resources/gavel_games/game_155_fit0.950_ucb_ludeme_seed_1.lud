(game
  "GAME_NAME"
  (players 2)
  (equipment
    {(board (square 9) use:Vertex) (piece "PIECE_ALPHA" Each)}
  )
  (rules
    (meta (swap))
    (play
      (move
        Add
        (to (sites Empty))
        (then
          (and
            (addScore Mover 1)
            (if
              (<
                2
                (count
                  Sites
                  in:
                  (sites Around (last To) NotEmpty Orthogonal)
                )
              )
              (moveAgain)
            )
          )
        )
      )
    )
    (end
      (if
        (is Full)
        (byScore
          {
            (score P1 (+ (score P1) (size Territory P1)))
            (score P2 (+ (score P2) (size Territory P2)))
          }
        )
      )
    )
  )
)
