(game
  "GAME_NAME"
  (players 2)
  (equipment
    {
      (board
        (splitCrossings
          (merge
            (shift 0.5 0.5 (scale 0.707 (square 2 diagonals:Solid)))
            (square 5 diagonals:Alternating)
          )
        )
        use:Vertex
      )
      (piece "PIECE_ALPHA" P1)
      (piece "PIECE_BETA" P2)
      (hand Each)
    }
  )
  (rules
    (play (move Add (to (sites Empty))))
    (end (if (is Line 3) (result Next Win)))
  )
)
