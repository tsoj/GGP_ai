(game
  "GAME_NAME"
  (players 2)
  (equipment
    {
      (board
        (merge
          (shift 0 (/ (- 7 3) 2) (rectangle 3 7 diagonals:Solid))
          (shift
            (/ (- 7 3) 2)
            0
            (rectangle 7 3 diagonals:Alternating)
          )
        )
        use:Vertex
      )
      (piece
        "PIECE_ALPHA"
        P1
        (or
          (move
            Hop
            (between if: (is Enemy (who at: (between))) (apply (remove (between))))
            (to if: (is Empty (to)))
          )
          (move Step (to if: (is Empty (to))))
        )
      )
      (piece
        "PIECE_BETA"
        P2
        N
        (move
          Step
          (directions {Rightward Forwards Leftward})
          (to if: (is Empty (to)))
        )
      )
    }
  )
  (rules
    phases:
    {
      (phase
        "Opening"
        (play
          (move
            Add
            (to (sites Empty) if: (< (count Cell at: (to)) 4))
          )
        )
        (nextPhase "Playing")
      )
      (phase
        "Playing"
        (play
          (move
            Add
            (to (sites Empty))
            (then (if (is Even (count MovesThisTurn)) (moveAgain)))
          )
        )
        (nextPhase "Playing")
      )
    }
    (end (if (is Line 5 All) (result Mover Win)))
  )
)
