(game
  "GAME_NAME"
  (players 2)
  (equipment
    {(board (rotate 30 (hex 4))) (piece "PIECE_ALPHA" Each)}
  )
  (rules
    (play (move Add (to (sites Empty))))
    (end
      (if
        (or
          {
            (is Loop)
            (is Connected 3 SidesNoCorners)
            (is Connected 2 Corners)
          }
        )
        (result Mover Win)
      )
    )
  )
)
