(game
  "GAME_NAME"
  (players 2)
  (equipment
    {
      (board
        (remove (square 9) edges: {{0 0} {2 2} {4 4} {6 6} {8 8}})
        use:Vertex
      )
      (piece "PIECE_ALPHA" Each)
    }
  )
  (rules
    (play (move Add (to (sites Empty))))
    (end
      (if
        (or
          {
            (is Loop)
            (is Connected 3 SidesNoCorners)
            (is Connected 2 Corners)
          }
        )
        (result Mover Win)
      )
    )
  )
)
