(game
  "GAME_NAME"
  (players 2)
  (equipment
    {
      (board
        (intersect {(hex 7) (shift -5.2 0 (hex Rectangle 7 14))})
      )
      (piece "PIECE_ALPHA" Each)
    }
  )
  (rules
    phases:
    {
      (phase
        "Opening"
        (play
          (move Add (to (sites Empty)) (then (set Var (last To))))
        )
        (nextPhase "Playing")
      )
      (phase
        "Playing"
        (play
          (move
            Add
            (to (sites Empty))
            (then (if (is Even (count MovesThisTurn)) (moveAgain)))
          )
        )
        (nextPhase "Playing")
      )
    }
    (end (if (is Line 5 All) (result Mover Win)))
  )
)
