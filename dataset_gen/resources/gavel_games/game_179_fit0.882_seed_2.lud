(game
  "GAME_NAME"
  (players 2)
  (equipment
    {
      (board (square 5))
      (piece
        "PIECE_ALPHA"
        P1
        (move Step (to if: (is Empty (to))))
      )
      (piece "PIECE_BETA" P2)
      (piece "PIECE_GAMMA" Neutral)
      (hand Each)
    }
  )
  (rules
    (play (move Add (to (sites Empty))))
    (end
      (if
        (or
          {
            (and
              (is Connected {(sites Side N) (sites Side S)})
              (not (can Move (move Add (to (sites Empty)))))
            )
            (and
              (is Connected {(sites Side NW) (sites Side SE)})
              (not (can Move (move Add (to (sites Empty)))))
            )
            (is Connected 4 Sides)
          }
        )
        (result Mover Win)
      )
    )
  )
)
