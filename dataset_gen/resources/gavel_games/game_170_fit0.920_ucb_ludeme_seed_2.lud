(game
  "GAME_NAME"
  (players 2)
  (equipment
    {
      (board (square 5 diagonals:Solid) use:Vertex)
      (piece
        "PIECE_ALPHA"
        Each
        (or
          (move Step (to if: (is Empty (to))))
          (move
            Hop
            (between if: (is Enemy (who at: (between))))
            (to if: (is Empty (to)))
          )
        )
      )
    }
  )
  (rules
    (play (move Add (to (sites Empty) if: (not (is Line 4)))))
    (end (if (is Line 5) (result Mover Win)))
  )
)
