(game
  "GAME_NAME"
  (players 2)
  (equipment
    {
      (board
        (merge
          {
            (rectangle 1 6)
            (shift 7 0 (rectangle 1 6))
            (shift 0 6 (rectangle 1 6))
            (shift 7 6 (rectangle 1 6))
          }
        )
      )
      (piece "PIECE_ALPHA" Each)
    }
  )
  (rules
    (play
      (move
        Add
        (to
          (sites Empty)
          if:
          (all
            Sites
            (sites Around (to) NotEmpty)
            if:
            (not (is In (site) (sites Around (last To))))
          )
        )
      )
    )
    (end (if (is Line 4) (result Mover Win)))
  )
)
