(game
  "GAME_NAME"
  (players 2)
  (equipment
    {
      (board (tri {3 5 3 5 3}) use:Vertex)
      (piece "PIECE_ALPHA" Each)
    }
  )
  (rules
    (play
      (move
        Add
        (to
          (sites Empty)
          if:
          (<=
            (count Steps All (to) (sites Perimeter))
            (size Group at: (to))
          )
        )
      )
    )
    (end (if (is Line 5 All exact:True) (result Mover Win)))
  )
)
