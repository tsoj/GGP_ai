(game
  "GAME_NAME"
  (players 2)
  (equipment {(board (square 11)) (piece "PIECE_ALPHA" Each)})
  (rules
    (play
      (if
        (is Prev Mover)
        (move
          Add
          (to (sites Around (sites Occupied by:Mover) Orthogonal))
        )
        (move
          Add
          (to (sites Empty))
          (then (if (is Line 5 All exact:True) (moveAgain)))
        )
      )
    )
    (end (if (is Line 5 All exact:True) (result Mover Win)))
  )
)
