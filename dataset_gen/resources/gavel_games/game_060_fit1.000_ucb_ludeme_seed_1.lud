(game
  "GAME_NAME"
  (players 2)
  (equipment {(board (hex 5)) (piece "PIECE_ALPHA" Each)})
  (rules
    (play
      (move
        Add
        (to
          (sites Empty)
          if:
          (all
            Sites
            (sites Around (to) NotEmpty)
            if:
            (not (is In (site) (sites Around (last To))))
          )
        )
      )
    )
    (end (if (is Line 4) (result Mover Win)))
  )
)
