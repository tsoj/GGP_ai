(game
  "GAME_NAME"
  (players {(player N) (player S)})
  (equipment
    {
      (board (rectangle 5 5 diagonals:Alternating) use:Vertex)
      (piece
        "PIECE_ALPHA"
        Each
        (or
          (move Step (to if: (is Empty (to))))
          (move
            Hop
            (between if: (is Enemy (who at: (between))) (apply (remove (between))))
            (to if: (is Empty (to)))
          )
        )
      )
    }
  )
  (rules
    (start
      {
        (place "PIECE_ALPHA1" (expand (sites Bottom)))
        (place "PIECE_ALPHA2" (expand (sites Top)))
      }
    )
    (play (forEach Piece))
    (end (if (no Pieces Next) (result Next Loss)))
  )
)
