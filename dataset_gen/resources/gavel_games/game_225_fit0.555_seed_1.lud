(game
  "GAME_NAME"
  (players 2)
  (equipment {(board (hex 5)) (piece "PIECE_ALPHA" Each)})
  (rules
    (meta (swap))
    (play (move Add (to (sites Empty))))
    (end
      (if
        (is Full)
        (byScore
          {
            (score
              P1
              (+
                (results
                  from:
                  (sites Occupied by:P1)
                  to:0
                  (if (= (id P1) (who at: (to))) 1 -1)
                )
              )
            )
            (score
              P2
              (+
                (results
                  from:
                  (sites Occupied by:P2)
                  to:0
                  (if (= (id P2) (who at: (to))) 1 -1)
                )
              )
            )
          }
        )
      )
    )
  )
)
