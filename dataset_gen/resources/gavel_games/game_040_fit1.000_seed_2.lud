(game
  "GAME_NAME"
  (players 2)
  (equipment
    {(board (square 15) use:Vertex) (piece "PIECE_ALPHA" Each)}
  )
  (rules
    (play
      (move
        Add
        (to (sites Empty))
        (then
          (and
            (addScore Mover 1)
            (if
              (!=
                2
                (count
                  Sites
                  in:
                  (sites Around (last To) NotEmpty Orthogonal)
                )
              )
              (moveAgain)
            )
          )
        )
      )
    )
    (end (if (is Occupied (centrePoint)) (result Next Loss)))
  )
)
