(game
  "GAME_NAME"
  (players 2)
  (equipment
    {
      (board (square 4 pyramidal:True) use:Vertex)
      (piece "PIECE_ALPHA" Each)
    }
  )
  (rules
    (play (move Add (to (sites Empty) if: (is Flat))))
    (end
      {
        (if
          (is Line (- (count Rows) (layer of: (last To))) SameLayer)
          (result Mover Win)
        )
        (if
          (is
            Line
            (- (- (count Rows) (layer of: (last To))) 1)
            SameLayer
          )
          (result Mover Loss)
        )
      }
    )
  )
)
