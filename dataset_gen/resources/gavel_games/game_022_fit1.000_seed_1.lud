(game
  "GAME_NAME"
  (players 2)
  (equipment
    {(board (rectangle 10 5)) (piece "PIECE_ALPHA" Each)}
  )
  (rules
    (play
      (if
        (is Prev Mover)
        (move
          Leap
          {{F F R F} {F F L F}}
          (to
            if:
            (not (is Friend (who at: (to))))
            (apply (if (is Enemy (who at: (to))) (remove (to))))
          )
        )
        (move
          Add
          (to (sites Empty))
          (then (if (is Line 5 All exact:True) (moveAgain)))
        )
      )
    )
    (end
      {
        (if (is Line 5 All exact:True) (result Mover Win))
        (if (is Line 3 All exact:True) (result Mover Loss))
      }
    )
  )
)
