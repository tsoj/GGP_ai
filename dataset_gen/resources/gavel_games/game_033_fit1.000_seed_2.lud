(game
  "GAME_NAME"
  (players 2)
  (equipment {(board (square 8)) (piece "PIECE_ALPHA" Each)})
  (rules
    (play (move Add (to (sites Empty))))
    (end
      (if
        (or
          {
            (is Line 4 All)
            (is Connected 3 SidesNoCorners)
            (is Connected 2 Corners)
          }
        )
        (result Mover Win)
      )
    )
  )
)
