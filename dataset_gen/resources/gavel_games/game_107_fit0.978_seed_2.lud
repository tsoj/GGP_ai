(game
  "GAME_NAME"
  (players 2)
  (equipment
    {(board (rotate 90 (hex 5))) (piece "PIECE_ALPHA" Each)}
  )
  (rules
    (meta (no Repeat))
    (play
      (move
        Add
        (to (sites Empty))
        (then
          (and
            (addScore Mover 1)
            (if
              (> (score Mover) 2)
              (add
                (piece (id "PIECE_ALPHA" Mover))
                (to
                  (intersection
                    (expand origin: (last To) Orthogonal)
                    (sites Occupied by:Next)
                  )
                )
              )
            )
          )
        )
      )
    )
    (end
      {
        (if (is Line 5) (result Mover Win))
        (if (is Line 4) (result Next Win))
      }
    )
  )
)
