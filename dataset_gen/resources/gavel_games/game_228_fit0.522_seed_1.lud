(game
  "GAME_NAME"
  (players 2)
  (equipment
    {
      (board (square 8))
      (piece "PIECE_ALPHA" Neutral (flips 1 2))
    }
  )
  (rules
    (start
      {
        (place
          "PIECE_ALPHA0"
          (difference (sites Centre) (sites Phase 1))
          state:1
        )
        (place
          "PIECE_ALPHA0"
          (difference (sites Centre) (sites Phase 0))
          state:2
        )
      }
    )
    phases:
    {
      (phase
        "Playing"
        (play
          (forEach
            Site
            (sites Empty)
            (append
              (custodial
                (from (site))
                (between
                  if:
                  (is Enemy (state at: (between)))
                  (apply
                    (allCombinations
                      (add (piece "PIECE_ALPHA0" state: (mover)) (to (site)))
                      (flip (between))
                    )
                  )
                )
                (to if: (not (is Friend (state at: (to)))))
              )
              (then
                (and
                  (set Score P1 (count Sites in: (sites State 1)))
                  (set Score P2 (count Sites in: (sites State 2)))
                )
              )
            )
          )
        )
      )
    }
    (end
      (if
        (is Full)
        {
          (if (> (score P1) (score P2)) (result P1 Win))
          (if (< (score P1) (score P2)) (result P2 Win))
          (if (> (count Pieces P1) (count Pieces P2)) (result P1 Win))
          (if (< (count Pieces P1) (count Pieces P2)) (result P2 Win))
        }
      )
    )
  )
)
