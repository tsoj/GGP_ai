(game
  "GAME_NAME"
  (players 2)
  (equipment
    {
      (board
        (intersect {(hex 7) (shift -5.2 0 (hex Rectangle 7 14))})
      )
      (piece "PIECE_ALPHA" Each)
    }
  )
  (rules
    (start
      {
        (set Score Each 2)
        (place "PIECE_ALPHA1" {"A1" "G7"})
        (place "PIECE_ALPHA2" {"A7" "G1"})
      }
    )
    (play
      (move
        Add
        (to (sites Empty))
        (then
          (addScore
            Mover
            (-
              (count Groups if: (= (who at: (to)) (mover)))
              (count Groups if: (= (who at: (to)) (next)))
            )
          )
        )
      )
    )
    (end
      (if
        (no Moves Next)
        {
          (if
            (>
              (-
                (count Groups if: (= (who at: (to)) P1) min:5)
                (count Groups if: (= (who at: (to)) P2) min:5)
              )
              0
            )
            (result P1 Win)
          )
          (if
            (<
              (-
                (count Groups if: (= (who at: (to)) P1) min:5)
                (count Groups if: (= (who at: (to)) P2) min:5)
              )
              0
            )
            (result P2 Win)
          )
          (if
            (=
              (-
                (count Groups if: (= (who at: (to)) P1) min:5)
                (count Groups if: (= (who at: (to)) P2) min:5)
              )
              0
            )
            (byScore)
          )
        }
      )
    )
  )
)
