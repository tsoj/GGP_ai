(game
  "GAME_NAME"
  (players 2)
  (equipment
    {
      (board
        (merge
          {
            (square 9 diagonals:Alternating)
            (shift 2 8 (rotate 180 (wedge 3)))
            (shift 2 -2 (wedge 3))
          }
        )
        use:Vertex
      )
      (piece
        "PIECE_ALPHA"
        Each
        (or
          (move
            Hop
            (between if: (is Enemy (who at: (between))) (apply (remove (between))))
            (to if: (is Empty (to)))
            (then
              (if
                (can
                  Move
                  (hop
                    (from (last To))
                    (between
                      if:
                      (and
                        (not (is In (between) (sites ToClear)))
                        (is Enemy (who at: (between)))
                      )
                    )
                    (to if: (is Empty (to)))
                  )
                )
                (moveAgain)
              )
            )
          )
          (move Step (to if: (is Empty (to))))
        )
      )
    }
  )
  (rules
    (meta (swap))
    (play (move Add (to (sites Empty))))
    (end
      {
        (if (is Line 4) (result Mover Win))
        (if (is Line 3) (result Mover Loss))
      }
    )
  )
)
