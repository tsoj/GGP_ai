(game
  "GAME_NAME"
  (players 2)
  (equipment
    {
      (board (square 7))
      (piece
        "PIECE_ALPHA"
        Each
        (or
          (move
            (from (from))
            (to (sites Around (from)) if: (is Empty (to)))
            copy:True
          )
          (move
            (from)
            (to
              (difference
                (expand origin: (from) steps:2)
                (expand origin: (from))
              )
              if:
              (is Empty (to))
            )
          )
          (then
            (and
              (set Score Mover 0)
              (forEach
                Group
                Orthogonal
                if:
                (is Mover (who at: (to)))
                (if
                  (is Odd (count Sites in: (sites)))
                  (and
                    (addScore Mover -1)
                    (forEach Site (sites) (set State at: (site) 0))
                  )
                  (and
                    (addScore Mover -2)
                    (forEach Site (sites) (set State at: (site) 1))
                  )
                )
              )
            )
          )
        )
      )
    }
  )
  (rules
    (start
      {
        (set Score Each 2)
        (place "PIECE_ALPHA1" {"A1" "G7"})
        (place "PIECE_ALPHA2" {"A7" "G1"})
      }
    )
    (play
      (forEach
        Piece
        (then
          (and
            (set
              Score
              Mover
              (/
                (+
                  (results
                    from:
                    (sites Occupied by:Mover)
                    to:
                    (sites
                      Around
                      (from)
                      if:
                      (= (what at: (from)) (what at: (to)))
                    )
                    1
                  )
                )
                2
              )
            )
            (set
              Score
              Next
              (/
                (+
                  (results
                    from:
                    (sites Occupied by:Next)
                    to:
                    (sites Around (from) if: (is Next (who at: (to))))
                    1
                  )
                )
                2
              )
            )
          )
        )
      )
    )
    (end (if (or (= (score Mover) 0) (is Full)) (byScore)))
  )
)
